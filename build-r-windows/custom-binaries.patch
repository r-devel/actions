diff --git a/src/main/Makefile.win b/src/main/Makefile.win
index 2a59ab2ff3..7472380f5f 100644
--- a/src/main/Makefile.win
+++ b/src/main/Makefile.win
@@ -49,9 +49,9 @@ endif
 
 platform-CPPFLAGS = -I../gnuwin32 -I../extra
 
-ifneq "$(R_ARCH)" ""
-  platform-CPPFLAGS += -DPLATFORM_PKGTYPE='"win.binary"'
-endif
+## Set custom binary package type to windows.binary.<arch>
+PKGTYPE_ARCH := $(subst aarch64,arm64,$(firstword $(subst -, ,$(shell $(CC) -dumpmachine))))
